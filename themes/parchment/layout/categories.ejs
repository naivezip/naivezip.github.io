<header class="page-header">
  <h1 class="page-title">分类</h1>
  <% if (site.categories && site.categories.length) { %>
    <p class="page-subtitle">共 <%= site.categories.length %> 个分类</p>
  <% } %>
</header>
<% if (site.categories && site.categories.length) { %>
  <div class="cat-grid">
    <% site.categories.sort('name').forEach(function (c) { %>
      <a class="cat-item" href="<%- url_for(c.path) %>">
        <span class="cat-name"><%= c.name %></span>
        <span class="cat-count"><%= c.posts.length %> 篇</span>
      </a>
    <% }) %>
  </div>
<% } else { %>
  <p class="page-subtitle">暂无分类。</p>
<% } %>
