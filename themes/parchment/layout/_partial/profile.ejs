<section class="home-intro">
  <img class="intro-avatar" src="<%- url_for(theme.avatar) %>" alt="<%= theme.author %>" width="48" height="48">
  <div class="intro-body">
    <div class="intro-title-row">
      <span class="intro-name"><%= theme.author %></span>
      <% if (theme.links && theme.links.length) { %>
        <div class="intro-links">
          <% theme.links.forEach(function (l) { %>
            <a class="intro-link" href="<%= l.url %>" target="_blank" rel="noopener"><%= l.name %> ↗</a>
          <% }) %>
        </div>
      <% } %>
    </div>
    <% if (theme.subtitle) { %>
      <p class="intro-bio"><%= theme.subtitle %></p>
    <% } %>
  </div>
</section>
