<header class="site-nav">
  <div class="nav-inner container">
    <a class="brand" href="<%- url_for('/') %>"><%= config.title %></a>
    <nav class="menu">
      <%
        var p = page.path || '';
        for (var name in theme.menu) {
          var url = theme.menu[name];
          var key = url.replace(/^\//, '').replace(/\/$/, '');
          var active = key === '' ? is_home() : (p === key + '/index.html' || p.indexOf(key + '/') === 0);
      %>
        <a class="menu-link<%= active ? ' active' : '' %>" href="<%- url_for(url) %>"><%= name %></a>
      <% } %>
    </nav>
    <form class="nav-search" action="<%- url_for('/search/') %>" method="get" role="search">
      <input type="search" name="q" placeholder="搜索…" aria-label="搜索文章">
    </form>
  </div>
</header>
