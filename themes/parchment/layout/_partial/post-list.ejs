<div class="post-list">
<% posts.forEach(function (post) {
  var raw = String(post.excerpt || post.content || '')
    .replace(/<td[^>]*class="[^"]*gutter[^"]*"[^>]*>[\s\S]*?<\/td>/gi, ' ');
  var ex = strip_html(raw)
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&lt;/gi, '<')
    .replace(/&gt;/gi, '>')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;|&apos;/gi, "'")
    .trim()
    .replace(/\s+/g, ' ');
  if (ex.length > 140) ex = ex.substring(0, 140) + '…';

  var hasCats = post.categories && post.categories.length;
  var tagItems = [];
  if (post.tags && post.tags.length) {
    post.tags.forEach(function (t) {
      if (tagItems.length < 4) tagItems.push(t);
    });
  }
%>
  <article class="post-row">
    <header class="post-row-head">
      <h2 class="post-row-title">
        <a href="<%- url_for(post.path) %>"><%= post.title || '(无标题)' %></a>
      </h2>
      <time class="post-row-date" datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
    </header>
    <% if (ex) { %>
      <p class="post-row-excerpt"><%= ex %></p>
    <% } %>
    <% if (hasCats || tagItems.length) { %>
      <div class="post-row-meta">
        <% if (hasCats) { %>
          <% post.categories.forEach(function (c) { %>
            <a class="meta-cat" href="<%- url_for(c.path) %>"><%= c.name %></a>
          <% }) %>
        <% } %>
        <% tagItems.forEach(function (t) { %>
          <a class="meta-tag" href="<%- url_for(t.path) %>">#<%= t.name %></a>
        <% }) %>
      </div>
    <% } %>
  </article>
<% }) %>
</div>
