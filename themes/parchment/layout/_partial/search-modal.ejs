<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="搜索文章" hidden>
  <div class="search-backdrop" data-close-modal></div>
  <div class="search-dialog">
    <div class="search-input-wrap">
      <input id="modal-search-input" type="search" placeholder="搜索文章标题、分类、标签或正文…" autocomplete="off" spellcheck="false" aria-label="搜索文章">
      <button class="search-esc" type="button" data-close-modal aria-label="关闭搜索">ESC</button>
    </div>
    <div class="search-modal-meta" id="search-modal-meta"></div>
    <div class="search-modal-results" id="search-modal-results" role="listbox"></div>
    <div class="search-modal-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>ESC</kbd> 关闭</span>
    </div>
  </div>
</div>
