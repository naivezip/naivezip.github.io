<article class="panel article">
  <header class="article-header">
    <h1 class="article-title"><%= page.title %></h1>
    <div class="meta">
      <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
      <% if (page.categories && page.categories.length) { %>
        <span class="meta-sep">·</span>
        <% page.categories.forEach(function (c) { %>
          <a class="meta-link" href="<%- url_for(c.path) %>"><%= c.name %></a>
        <% }) %>
      <% } %>
      <% if (page.tags && page.tags.length) { %>
        <span class="meta-sep">·</span>
        <% page.tags.forEach(function (t) { %>
          <a class="meta-link tag" href="<%- url_for(t.path) %>">#<%= t.name %></a>
        <% }) %>
      <% } %>
    </div>
  </header>
  <div class="article-content"><%- page.content %></div>
</article>
<nav class="post-nav">
  <span>
    <% if (page.prev) { %>
      <a class="chip" href="<%- url_for(page.prev.path) %>">← <%= page.prev.title || '上一篇' %></a>
    <% } %>
  </span>
  <span>
    <% if (page.next) { %>
      <a class="chip" href="<%- url_for(page.next.path) %>"><%= page.next.title || '下一篇' %> →</a>
    <% } %>
  </span>
</nav>
